@model CadastrarFuncionarioViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro De Funcionario";
}

<p>
    <a href="Cadastrar">Cadastrar Funcionario</a>
</p>

<form asp-action="Cadastrar" method="post">
    <div>
        <label asp-for="Nome"></label>
        <br>
        <input asp-for="Nome" type="text">
    </div>
    <div>
        <label asp-for="Telefone"></label>
        <br>
        <input asp-for="Telefone" type="text">
    </div>
    <div>
        <label asp-for="Cpf"></label>
        <br>
        <input asp-for="Cpf" type="text">
    </div>

    <button type="submit"></button>
</form>

<p>
    <a asp-action="Listar">Voltar para a Lista</a>
</p>
