@model List<ListarFuncionarioViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem De Funcionarios";
}

<p>
    <a class="btn btn-primary" href="Cadastrar">Cadastrar Funcionario</a>
</p>


@if (Model.Count == 0)
{
    <div class="alert alert-warning col-6" role="alert">
        Não há funcionarios cadastrados!
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Telefone</th>
            </tr>
        </thead>

        <tbody>
            @foreach (ListarFuncionarioViewModel f in Model)
            {
                <tr>
                    <td>@f.Id</td>
                    <td>@f.Nome</td>
                    <td>@f.Telefone</td>
                    <td>
                        <a href="Editar/@f.Id" class="btn btn-outline-primary">Editar</a>
                        <a href="Excluir/@f.Id" class="btn btn-outline-primary">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
