@using ControleDeMedicamentos.WebApp.ModuloFuncionarios
@model List<Funcionario>

<h2>Controle de Funcionarios</h2>

<hr />
<a href="/">Inicio</a> /
<a href="/Fornecedor/Listar">Fornecedores</a> /
<a href="/Medicamento/Listar">Medicamentos</a> /
<a href="/Funcionario/Listar">Funcionarios</a> /
<hr />

<h1>Listagem De Funcionarios</h1>

<p>
    <a href="Cadastrar">Cadastrar Funcionario</a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>CPF</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Funcionario f in Model)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Nome</td>
                <td>@f.Telefone</td>
                <td>@f.Cpf</td>
                <td>
                    <a href="Editar/@f.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@f.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
