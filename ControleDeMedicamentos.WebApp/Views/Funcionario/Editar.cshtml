@model EditarFuncionarioViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição De Funcionario";
}

<div class="row">
    <form class="col-6" asp-action="Editar" asp-route-id="@Model.Id" method="post">

        <input asp-for="Id" type="hidden">

        <div>
            <label class="form-label" asp-for="Nome"></label>
            <br>
            <input class="form-control" asp-for="Nome" type="text">
        </div>
        <div>
            <label class="form-label" asp-for="Telefone"></label>
            <br>
            <input class="form-control" asp-for="Telefone" type="text">
        </div>
        <div>
            <label class="form-label" asp-for="Cpf">CPF</label>
            <br>
            <input class="form-control" asp-for="Cpf" type="text">
        </div>

        <button type="submit" class="btn btn-primary mt-3">Confirmar</button>

        <a class="btn btn-outline-secondary mt-3" asp-action="Listar">Voltar para a Lista</a>
    </form>
</div>
