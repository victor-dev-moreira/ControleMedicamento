@model EditarFuncionarioViewModel;

<h2>Controle de Medicamentos</h2>

<hr />
<a asp-controller="Home" asp-action="Index">Inicio</a> /
<a asp-controller="Fornecedor" asp-action="Listar">Fornecedores</a> /
<a asp-controller="Medicamento" asp-action="Listar">Medicamentos</a> /
<a asp-controller="Funcionario" asp-action="Listar">Funcionarios</a> /
<a asp-controller="Paciente" asp-action="Listar">Pacientes</a> /
<hr />

<h1>Edição De Funcionario</h1>

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">

    <input asp-for="Id" type="hidden">

    <div>
        <label asp-for="Nome"></label>
        <br>
        <input asp-for="Nome" type="text">
    </div>
    <div>
        <label asp-for="Telefone"></label>
        <br>
        <input asp-for="Telefone" type="text">
    </div>
    <div>
        <label asp-for="Cpf"></label>
        <br>
        <input asp-for="Cpf" type="text">
    </div>

    <button type="submit">Confirmar</button>
</form>

<p>
    <a asp-action="Listar">Voltar para a Lista</a>
</p>
