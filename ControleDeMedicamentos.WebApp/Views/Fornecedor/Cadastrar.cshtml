@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro De Fornecedor";
}

<p>
    <a href="Cadastrar">Cadastrar Fornecedor</a>
</p>

<div class="row">
    <form class="col-6" asp-action="Cadastrar" method="post">
        <div>
            <label class="form-label" for="nome"></label>
            <input class="form-control" type="text" name="nome" id="nome">
        </div>
        <div class="mt-4">
            <label class="form-label" for="telefone">Telefone</label>
            <input class="form-control" type="text" name="telefone" id="telefone">
        </div>
        <div class="mt-4">
            <label class="form-label" for="cnpj">CNPJ</label>
            <input class="form-control" type="text" name="cnpj" id="cnpj">
        </div>

        <button type="submit" class="btn btn-primary mt-3">Cadastrar</button>

        <a class="btn btn-outline-secondary mt-3" href="Listar">Voltar para a Lista</a>
    </form>
</div>

