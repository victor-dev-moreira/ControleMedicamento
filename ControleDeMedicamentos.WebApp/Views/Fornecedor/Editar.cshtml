<h1>Edição De Fornecedor</h1>

<form action="/Fornecedor/Editar/@Model.Id" method="post">
    <div>
        <label for="nome">Nome</label>
        <input type="text" name="nome" id="nome" value="@Model.Nome">
    </div>
    <div>
        <label for="telefone">Telefone</label>
        <input type="text" name="telefone" id="telefone" value="@Model.Telefone">
    </div>
    <div>
        <label for="cnpj">CNPJ</label>
        <input type="text" name="cnpj" id="cnpj" value="@Model.Cnpj">
    </div>

    <button type="submit">Confirmar Edicão</button>
</form>

<p>
    <a href="Listar">Voltar para a Lista</a>
</p>
