@model List<Fornecedor>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem De Fornecedores";
}

<p>
    <a class="btn btn-primary" href="Cadastrar">
        <i class="bi bi-patch-plus"></i>
        Cadastrar Fornecedor
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning col-6" role="alert">
        Não há fornecedores cadastrados!
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">

        @foreach (Fornecedor f in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@f.Nome</h5>
                            <span class="badge text-bg-secondary">@f.Id</span>
                        </div>

                        <dl class="row mb-2">
                            <dt class="col-sm-4">Telefone</dt>
                            <dd class="col-sm-8">@f.Telefone</dd>

                            <dt class="col-sm-4">CNPJ</dt>
                            <dd class="col-sm-8">@f.Cnpj</dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a href="Editar/@f.Id " class="btn btn-outline-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="Excluir/@f.Id" class="btn btn-outline-danger" title="Excluir">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Telefone</th>
                <th>CNPJ</th>
                <th>Acões</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Fornecedor f in Model)
            {

                <tr>
                    <td>@f.Id</td>
                    <td>@f.Nome</td>
                    <td>@f.Telefone</td>
                    <td>@f.Cnpj</td>
                    <td>
                        <a href="Editar/@f.Id " class="btn btn-outline-primary">Editar</a>
                        <a href="Excluir/@f.Id" class="btn btn-outline-danger">Excluir</a>
                    </td>
                </tr>

            }
        </tbody>
    </table> *@
}
