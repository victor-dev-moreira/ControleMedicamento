@model CadastrarMedicamentoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro De Medicamento";
}

<div class="row">
    <form class="col-lg-6" asp-action="Cadastrar" method="post">
        <div>
            <label class="form-label" asp-for="Nome"></label>
            <input class="form-control" asp-for="Nome" type="text">
        </div>
        <div>
            <label class="form-label" asp-for="Descricao">Descrição</label>
            <textarea class="form-control" asp-for="Descricao" type="text"></textarea>
        </div>
        <div>
            <label asp-for="FornecedorId">Fornecedor</label>
        </br>

        <select class="form-select form-select-lg mb-3" name="FornecedorId" id="FornecedorId">
            <option selected>Selecione Fornecedor</option>
            @foreach (Fornecedor f in ViewBag.Fornecedores)
            {
                <option value="@f.Id">@f.Nome</option>
            }

        </select>

    </div>
    <button type="submit" class="btn btn-primary mt-3">
        <i class="bi bi-check"></i>
        Cadastrar
    </button>

    <a class="btn btn-outline-secondary mt-3" asp-action="Listar">
        <i class="bi bi-arrow-return-left"></i>
        Voltar para a Lista</a>
    </form>


