@model List<Paciente>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem De Pacientes";
}

<p>
    <a href="Cadastrar">Cadastrar Pacientes</a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Cartão Sus</th>
            <th>CPF</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Paciente p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@p.Telefone</td>
                <td>@p.CartaoSus</td>
                <td>@p.Cpf</td>
                <td>
                    <a href="Editar/@p.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@p.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
