<h1>Edição De Paciente</h1>

<form action="/Paciente/Editar/@Model.Id" method="post">
    <div>
        <label for="nome">Nome</label>
        <input type="text" name="nome" id="nome" value="@Model.Nome">
    </div>
    <div>
        <label for="telefone">Telefone</label>
        <input type="text" name="telefone" id="telefone" value="@Model.Telefone">
    </div>
    <div>
        <label for="cartaoSus">Cartão SUS</label>
        <input type="text" name="cartaoSus" id="cartaoSus" value="@Model.CartaoSus">
    </div>
    <div>
        <label for="cpf">CPF</label>
        <input type="text" name="cpf" id="cpf" value="@Model.Cpf">
    </div>

    <button type="submit">Confirmar Edicão</button>
</form>

<p>
    <a href="Listar">Voltar para a Lista</a>
</p>
