@model EditarPacienteViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição De Paciente";
}

<div class="row">
    <form class="col-lg-6" asp-action="Editar" method="post">
        <div>
            <label class="form-label" asp-for="Nome"></label>
            <input class="form-control" asp-for="Nome" type="text">
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>
        <div class="mt-4">
            <label class="form-label" asp-for="Telefone"></label>
            <input class="form-control" asp-for="Telefone" type="text">
            <span class="text-danger" asp-validation-for="Telefone"></span>
        </div>
        <div class="mt-4">
            <label class="form-label" asp-for="Cpf">CPF</label>
            <input class="form-control" asp-for="Cpf" type="text">
            <span class="text-danger" asp-validation-for="Cpf"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="CartaoSus">Cartão SUS</label>
            <input class="form-control" asp-for="CartaoSus" type="text">
            <span class="text-danger" asp-validation-for="CartaoSus"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">
            <i class="bi bi-check"></i>
            Cadastrar
        </button>
        <a class="btn btn-outline-secondary mt-3" asp-action="Listar">
            <i class="bi bi-arrow-return-left"></i>
            Voltar para a Lista
        </a>
    </form>
</div>
